# LearnMate AI - Environment Configuration Example

# MongoDB Connection String (e.g. MongoDB Atlas for Vercel/Production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnmate?retryWrites=true&w=majority

# JWT Secret for Auth Authentication
JWT_SECRET=learnmate_secret_jwt_key_sih2026_super_safe

# Google Gemini AI API Key for AI Tutor & Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default 5050 locally)
PORT=5050
